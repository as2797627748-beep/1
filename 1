#!/bin/bash
# ==============================================================================
# IRON-DOME SINGULARITY 2026 — 1核1G单机最强极限版 (高兼容/全量功能回归/定稿版)
# ------------------------------------------------------------------------------
# 修复与优化: 暴力SHA256字符串校验、自适应内存列($NF)、多级端口双杀、Systemd内核自适应
# 特性：地域感知SNI、热加载回滚、焦土卸载、Sysctl深度压榨、1G Swap自动补全
# ==============================================================================

set -o pipefail

# --- 1. 全局常量与静态指纹 ---
ENV_FILE="/etc/sing-box/.iron_dome_env"
CONFIG_PATH="/etc/sing-box/config.json"
SB_BIN="/usr/local/bin/sing-box"
SB_VER="1.13.8"
SYSCTL_CONF="/etc/sysctl.d/99-singbox.conf"
LOG_FILE="/var/log/sing-box.log"
BACKUP_DIR="/etc/sing-box/backups"

BLUE='\033[34m'; GREEN='\033[32m'; YELLOW='\033[33m'; RED='\033[31m'; NC='\033[0m'

msg() { echo -e "${BLUE}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
err() {
    echo -e "${RED}[ERROR]${NC} $1"
    [[ -f "$LOG_FILE" ]] && tail -n 15 "$LOG_FILE"
    return 1 2>/dev/null || exit 1
}

[[ $EUID -ne 0 ]] && err "必须以 root 权限运行。" && return 1 2>/dev/null || exit 1

GLOBAL_TMP=$(mktemp -d)
trap 'rm -rf "$GLOBAL_TMP"' EXIT

# --- 2. 辅助函数：安全锁死封装 (兼容无 chattr 环境) ---
set_immutable() {
    if command -v chattr &>/dev/null; then chattr +i "$@" 2>/dev/null || true; fi
}
remove_immutable() {
    if command -v chattr &>/dev/null; then chattr -i "$@" 2>/dev/null || true; fi
}

# --- 3. 辅助函数：地域感知与探测 ---
get_loc() {
    local loc=$(curl -s --connect-timeout 2 ipinfo.io/country 2>/dev/null ||
    curl -s --connect-timeout 2 ipapi.co/country/ 2>/dev/null || echo "Unknown")
    echo "$loc"
}

get_rand_sni() {
    local loc=$(get_loc)
    local pool=()
    case "$loc" in
        "JP") pool=("www.nintendo.co.jp" "www.sony.jp" "www.rakuten.co.jp" "www.line.me") ;;
        "US") pool=("www.visa.com" "www.stripe.com" "www.paypal.com" "www.cisco.com") ;;
        "DE"|"FR"|"GB"|"EU") pool=("www.airbus.com" "www.siemens.com" "www.volkswagen.de" "www.shell.com") ;;
        *) pool=("www.cloudfront.net" "www.nvidia.com" "www.intel.com" "www.akamai.com" "www.icloud.com") ;;
    esac
    echo "${pool[$RANDOM % ${#pool[@]}]}"
}

# --- 4. 环境初始化与校时 (含 Swap 补全与端口斩杀) ---
prepare_env() {
    msg "执行 1核1G 全量加固环境初始化..."
    mkdir -p /etc/sing-box /var/lib/sing-box "$BACKUP_DIR"

    # 备份轮转
    [[ $(ls -1 "$BACKUP_DIR"/*.bak 2>/dev/null | wc -l) -gt 3 ]] && ls -t "$BACKUP_DIR"/*.bak | tail -n +4 | xargs rm -f
    touch "$LOG_FILE" && chmod 600 "$LOG_FILE"

    # 修复兼容：Swap 防 OOM 机制探测最后可用列 ($NF)
    if [[ ! -f /swapfile ]]; then
        local mem_avail=$(free -m | awk '/Mem:/ {print $NF}')
        if [[ -n "$mem_avail" ]] && [ "$mem_avail" -lt 512 ]; then
            warn "内存极度不足，开启 1G Swap 虚拟内存防止闪退"
            dd if=/dev/zero of=/swapfile bs=1M count=1024 status=none
            chmod 600 /swapfile && mkswap /swapfile >/dev/null 2>&1 && swapon /swapfile
            grep -q "/swapfile" /etc/fstab || echo "/swapfile swap swap defaults 0 0" >> /etc/fstab
        fi
    fi

    remove_immutable /etc/sing-box/.* /etc/sing-box/* /etc/systemd/system/sing-box.service /etc/sysctl.d/99-singbox.conf
    pkill -9 sing-box 2>/dev/null || true
    sync && echo 3 > /proc/sys/vm/drop_caches

    # 全量工具链安装
    export DEBIAN_FRONTEND=noninteractive
    if command -v apt-get &>/dev/null; then
        apt-get update -qq && apt-get install -y -qq curl openssl tar chrony logrotate iproute2 net-tools cron ufw firewalld psmisc >/dev/null 2>&1 || true
    elif command -v dnf &>/dev/null; then
        dnf makecache -q && dnf install -y -q curl openssl tar chrony logrotate iproute2 net-tools cron firewalld psmisc >/dev/null 2>&1 || true
    fi

    # 443 端口双杀逻辑
    if command -v fuser &>/dev/null; then fuser -k -9 443/tcp >/dev/null 2>&1 || true; fi
    if command -v lsof &>/dev/null; then lsof -t -i:443 | xargs kill -9 2>/dev/null || true; fi

    systemctl enable --now chrony &>/dev/null || systemctl enable --now chronyd &>/dev/null || true
    chronyc makestep >/dev/null 2>&1 || true

    cat <<EOF > /etc/logrotate.d/sing-box
$LOG_FILE {
    daily
    rotate 3
    size 5M
    copytruncate
    missingok
    notifempty
    compress
}
EOF
}

# --- 5. 三级架构下载与暴力指纹校验 ---
download_core() {
    local ARCH=$(uname -m)
    local S_ARCH="amd64"
    case "$ARCH" in
        x86_64) S_ARCH="amd64" ;;
        aarch64) S_ARCH="arm64" ;;
        armv7*) S_ARCH="armv7" ;;
        *) err "不支持的架构: $ARCH" ;;
    esac

    local suffix="sing-box-${SB_VER}-linux-${S_ARCH}.tar.gz"
    local raw_url="https://github.com/SagerNet/sing-box/releases/download/v${SB_VER}/${suffix}"
    local sha_url="https://github.com/SagerNet/sing-box/releases/download/v${SB_VER}/sing-box-${SB_VER}.sha256sum"

    local mirrors=(
        "$raw_url"
        "https://mirror.ghproxy.com/${raw_url}"
        "https://ghp.ci/${raw_url}"
        "https://hub.gitmirror.com/${raw_url}"
    )

    local success=0
    for url in "${mirrors[@]}"; do
        msg "下载尝试: $url"
        if curl -sSL --connect-timeout 5 --max-time 30 -Lo "$GLOBAL_TMP/sb.tar.gz" "$url"; then
            success=1 && break
        fi
    done
    [[ $success -eq 0 ]] && err "所有下载链路均失效"

    msg "执行暴力指纹校验..."
    local OFFICIAL_DATA=$(curl -sSL --connect-timeout 5 "$sha_url" || echo "")
    local local_sha=$(sha256sum "$GLOBAL_TMP/sb.tar.gz" | awk '{print $1}')

    if [[ -z "$OFFICIAL_DATA" ]]; then
        warn "网络异常无法获取官方指纹，强行放行部署"
    elif ! echo "$OFFICIAL_DATA" | grep -q "$local_sha"; then
        err "文件被篡改！本地: $local_sha" && return 1
    else
        msg "指纹校验完美匹配 ($local_sha)"
    fi

    tar -zxf "$GLOBAL_TMP/sb.tar.gz" -C "$GLOBAL_TMP"
    mv "$GLOBAL_TMP"/sing-box-*/sing-box "$SB_BIN"
    chmod +x "$SB_BIN"
}

# --- 6. 性能极致微调 (1核1G专属优化) ---
init_system() {
    msg "注入 1核1G 极限压榨参数与抗泛洪强化..."
    modprobe tcp_bbr 2>/dev/null || true

    cat <<EOF > "$SYSCTL_CONF"
fs.file-max=1048576
vm.swappiness=10
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
net.ipv4.ip_forward=1
net.ipv6.conf.all.forwarding=1
net.ipv4.tcp_syncookies=1
net.ipv4.tcp_max_syn_backlog=8192
net.core.somaxconn=4096
net.core.netdev_max_backlog=10000
net.ipv4.tcp_tw_reuse=1
net.ipv4.tcp_rmem=4096 87380 67108864
net.ipv4.tcp_wmem=4096 65536 67108864
EOF

    sysctl -p "$SYSCTL_CONF" >/dev/null 2>&1 || sysctl --system >/dev/null 2>&1 || true

    cat <<EOF > /etc/security/limits.d/99-singbox.conf
* soft nofile 1048576
* hard nofile 1048576
root soft nofile 1048576
root hard nofile 1048576
EOF
}

# --- 7. 配置生成与 Systemd 自适应 ---
deploy_config() {
    msg "执行配置部署 (TUIC ECC-384 强化)..."
    [[ -f "$CONFIG_PATH" ]] && cp -f "$CONFIG_PATH" "${BACKUP_DIR}/config_$(date +%s).bak"
    remove_immutable "$ENV_FILE" "$CONFIG_PATH" /etc/sing-box/tuic.* /etc/systemd/system/sing-box.service

    if ! getent group sing-box >/dev/null; then groupadd -r sing-box; fi
    if ! getent passwd sing-box >/dev/null; then useradd -r -M -s /sbin/nologin -g sing-box sing-box; fi

    if [[ ! -f "$ENV_FILE" ]]; then
        local KEYS=$("$SB_BIN" generate reality-keypair)
        local PRIV_K=$(echo "$KEYS" | grep -i 'Private' | awk -F ': ' '{print $2}' | tr -d ' ')
        local PUB_K=$(echo "$KEYS" | grep -i 'Public' | awk -F ': ' '{print $2}' | tr -d ' ')
        local SNI=$(get_rand_sni)
        cat <<EOF > "$ENV_FILE"
UUID="$("$SB_BIN" generate uuid)"
PRIV_K="$PRIV_K"
PUB_K="$PUB_K"
TUIC_PASS="$(openssl rand -hex 16)"
SHORT_ID="$(openssl rand -hex 4)"
SNI="$SNI"
EOF
    fi
    source "$ENV_FILE"

    openssl ecparam -genkey -name secp384r1 -out /etc/sing-box/tuic.key 2>/dev/null
    openssl req -new -x509 -nodes -key /etc/sing-box/tuic.key -out /etc/sing-box/tuic.crt -days 3650 -subj "/CN=$SNI" 2>/dev/null

    cat <<EOF > "$CONFIG_PATH"
{
  "log": { "level": "error", "timestamp": true, "output": "$LOG_FILE" },
  "inbounds": [
    {
      "type": "vless", "tag": "vless-in", "listen": "::", "listen_port": 443, "network": "tcp",
      "users": [{ "uuid": "$UUID", "flow": "xtls-rprx-vision" }],
      "tls": {
        "enabled": true, "server_name": "$SNI", "utls": { "enabled": true, "fingerprint": "chrome" },
        "reality": {
          "enabled": true, "handshake": { "server": "$SNI", "server_port": 443 },
          "private_key": "$PRIV_K", "short_id": ["$SHORT_ID"]
        }
      }
    },
    {
      "type": "tuic", "tag": "tuic-in", "listen": "::", "listen_port": 443, "network": "udp",
      "users": [{ "uuid": "$UUID", "password": "$TUIC_PASS" }],
      "congestion_control": "bbr",
      "tls": {
        "enabled": true,
        "certificate_path": "/etc/sing-box/tuic.crt",
        "key_path": "/etc/sing-box/tuic.key"
      }
    }
  ],
  "outbounds": [{ "type": "direct", "tag": "direct" }]
}
EOF

    # Systemd 内核版本自适应内存限制
    local mem_limit="MemoryLimit=850M"
    local sysd_ver=$(systemctl --version | head -n1 | grep -oE '[0-9]+' | head -1 || echo 0)
    [[ $sysd_ver -ge 232 ]] && mem_limit="MemoryHigh=750M\nMemoryMax=850M"

    cat <<EOF > /etc/systemd/system/sing-box.service
[Unit]
Description=IRON-DOME APEX
After=network.target nss-lookup.target

[Service]
User=sing-box
Group=sing-box
ExecStart=$SB_BIN run -c $CONFIG_PATH
ExecReload=/bin/kill -HUP \$MAINPID
Restart=always
RestartSec=3s
LimitNOFILE=1048576
$(echo -e "$mem_limit")
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
StandardOutput=append:$LOG_FILE
StandardError=inherit

[Install]
WantedBy=multi-user.target
EOF

    chown -R sing-box:sing-box /etc/sing-box /var/lib/sing-box
    chmod 600 "$CONFIG_PATH" "$ENV_FILE" /etc/sing-box/tuic.*
    set_immutable "$CONFIG_PATH" "$ENV_FILE" /etc/sing-box/tuic.*

    systemctl daemon-reload
    systemctl enable --now sing-box >/dev/null 2>&1
}

# --- 8. 防火墙顶级安全强化 ---
apply_firewall() {
    msg "配置 UFW/Firewalld 双重防御策略..."
    if command -v ufw &>/dev/null; then
        ufw allow ssh && ufw allow 443/tcp && ufw allow 443/udp && ufw --force enable || true
    fi
    if command -v firewall-cmd &>/dev/null; then
        firewall-cmd --permanent --add-port=443/tcp && firewall-cmd --permanent --add-port=443/udp && firewall-cmd --reload || true
    fi
}

# --- 9. 运维逻辑：热加载与自愈 ---
reload_config() {
    msg "执行无感热加载 (回滚保护模式)..."
    local mem_avail=$(free -m | awk '/Mem:/ {print $NF}')
    [[ "$mem_avail" -lt 100 ]] && warn "内存告急，热加载存在 OOM 风险！"

    local CONFIG_BAK="${GLOBAL_TMP}/config_bak.json"
    local ENV_BAK="${GLOBAL_TMP}/env_bak.env"
    cp -f "$CONFIG_PATH" "$CONFIG_BAK"
    cp -f "$ENV_FILE" "$ENV_BAK"

    remove_immutable "$CONFIG_PATH" "$ENV_FILE" /etc/sing-box/tuic.*
    source "$ENV_FILE"
    local OLD_SNI="$SNI"
    local new_sni=$(get_rand_sni)

    sed -i "s|^SNI=.*|SNI=\"$new_sni\"|" "$ENV_FILE"
    sed -i "s|\"$OLD_SNI\"|\"$new_sni\"|g" "$CONFIG_PATH"

    openssl req -new -x509 -nodes -key /etc/sing-box/tuic.key -out /etc/sing-box/tuic.crt -days 3650 -subj "/CN=$new_sni" 2>/dev/null
    set_immutable "$CONFIG_PATH" "$ENV_FILE" /etc/sing-box/tuic.*

    if systemctl reload sing-box && sleep 2 && systemctl is-active --quiet sing-box; then
        msg "热加载完成，SNI 已更新为: $new_sni"
    else
        warn "热加载失败，自动回滚..."
        remove_immutable "$CONFIG_PATH" "$ENV_FILE" /etc/sing-box/tuic.*
        cp -f "$CONFIG_BAK" "$CONFIG_PATH"
        cp -f "$ENV_BAK" "$ENV_FILE"
        set_immutable "$CONFIG_PATH" "$ENV_FILE" /etc/sing-box/tuic.*
        systemctl restart sing-box
    fi
    show_panel
}

boot_verify() {
    cat << 'EOF' > /etc/sing-box/boot_check.sh
#!/bin/bash
sleep 15
if ! systemctl is-active --quiet sing-box; then
    systemctl restart sing-box
    echo "$(date) [BOOT_REPAIR] Sing-box restarted" >> /var/log/sing-box.log
fi
EOF
    chmod +x /etc/sing-box/boot_check.sh
    if command -v crontab &>/dev/null; then
        (crontab -l 2>/dev/null | grep -v "boot_check.sh"; echo "@reboot /etc/sing-box/boot_check.sh") | crontab -
    fi
}

# --- 10. 面板展示 (含完整链接) ---
show_panel() {
    source "$ENV_FILE" 2>/dev/null || return
    local IP=$(curl -s --connect-timeout 2 api.ipify.org 2>/dev/null || curl -s ifconfig.me || echo "YOUR_IP")
    local loc=$(get_loc)
    local RAM_USE=$(ps -C sing-box -o rss= 2>/dev/null | awk '{sum+=$1} END {printf "%.1f MB", sum/1024}' || echo "N/A")

    clear
    echo -e "${GREEN}==============================================${NC}"
    echo -e "         IRON-DOME APEX (FINAL BUILD)         "
    echo -e "${GREEN}==============================================${NC}"
    echo -e " 服务状态: RUNNING | 内存占用: $RAM_USE"
    echo -e " 地域: $loc | 当前SNI: $SNI"
    echo "----------------------------------------------"
    echo -e "Reality (VLESS):"
    echo -e "vless://${UUID}@${IP}:443?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${SNI}&fp=chrome&pbk=${PUB_K}&sid=${SHORT_ID}#IRON-VLESS"
    echo ""
    echo -e "TUIC v5:"
    echo -e "tuic://${UUID}:${TUIC_PASS}@${IP}:443?congestion_control=bbr&alpn=h3&sni=${SNI}#IRON-TUIC"
    echo -e "${GREEN}==============================================${NC}"
}

# --- 11. 焦土式深度卸载 ---
deep_uninstall() {
    read -rp "⚠️ 确认执行全量焦土卸载？[y/N]: " confirm
    [[ "${confirm,,}" != "y" ]] && return 0

    systemctl stop sing-box && systemctl disable sing-box
    remove_immutable /etc/sing-box/* /etc/sing-box/.*
    if command -v crontab &>/dev/null; then crontab -l | grep -v "boot_check.sh" | crontab -; fi
    rm -rf /etc/sing-box /var/lib/sing-box /usr/local/bin/sing-box /etc/systemd/system/sing-box.service /etc/sysctl.d/99-singbox.conf /etc/security/limits.d/99-singbox.conf /etc/logrotate.d/sing-box
    systemctl daemon-reload && sysctl --system >/dev/null 2>&1
    userdel -r sing-box 2>/dev/null || true
    msg "焦土式卸载完成，系统已恢复纯净。"
}

# --- 主入口 ---
while true; do
    echo -e "\n1. 🚀 部署全量加固 | 2. 📊 状态面板 | 3. ♻️ 热加载SNI | 4. 📝 实时日志 | 5. 🗑️ 深度卸载 | 0. 退出"
    read -rp ">> 请输入操作序号: " opt
    case $opt in
        1) prepare_env && download_core && init_system && apply_firewall && deploy_config && boot_verify && show_panel ;;
        2) show_panel ;;
        3) reload_config ;;
        4) journalctl -u sing-box -f -n 50 || tail -f "$LOG_FILE" ;;
        5) deep_uninstall ;;
        0) exit 0 ;;
        *) warn "无效选项" ;;
    esac
done
